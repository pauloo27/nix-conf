input {
    focus-follows-mouse max-scroll-amount="0%"

    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
            options "caps:swapescape"
        }

        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }
}
